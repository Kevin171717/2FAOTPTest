# Copy these values to .env. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Pricing snapshot used only for experiment cost estimates (USD per 1M tokens).
# Update these values if the official model price changes.
OPENAI_INPUT_USD_PER_M=2.50
OPENAI_CACHED_INPUT_USD_PER_M=1.25
# GPT-4o does not currently report a separate cache-write price; use input price if present.
OPENAI_CACHE_WRITE_USD_PER_M=2.50
OPENAI_OUTPUT_USD_PER_M=10.00

OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=300
# Used only when OPENAI_MODEL is a GPT-5 model.
OPENAI_REASONING_EFFORT=none
BGE_ANCHOR_THRESHOLD=0.50
OPENAI_SCORE_GAP_THRESHOLD=0.05
OPENAI_NOTIFICATION_MARGIN=0.03
